# Optional future server-rendered application. The Course Hub API already has
# its own enabled proxy and does not use this file.
#
# Enable only after a service is healthy on 127.0.0.1:3001:
#   sudo cp nextjs-proxy.conf.disabled \
#     /etc/nginx/phy301/locations-enabled/20-nextjs-app.conf
#   sudo nginx -t && sudo systemctl reload nginx

location ^~ /app/ {
    proxy_pass http://127.0.0.1:3001;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
}
