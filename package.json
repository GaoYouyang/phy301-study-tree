{
  "name": "phy301-study-tree",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:pages": "GITHUB_PAGES=true next build && node scripts/prepare-pages-output.mjs",
    "audit:math": "tsx scripts/audit-math-rendering.ts",
    "start": "next start",
    "test": "npm run audit:math && npm run build:pages && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern out --ignore-pattern docs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "katex": "0.19.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/katex": "0.16.8",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.5"
  },
  "type": "module"
}
