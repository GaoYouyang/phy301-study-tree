{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gaoyouyang.site/schemas/course-materials-v1.json",
  "title": "Course source material inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "course",
    "generatedAt",
    "inventoryStatus",
    "inventoryNote",
    "summary",
    "materials",
    "knownGaps",
    "freshness"
  ],
  "properties": {
    "schemaVersion": { "const": "course-materials/v1" },
    "course": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "slug", "route", "nameZh", "nameEn"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "route": { "type": "string", "pattern": "^/[a-z0-9-]+/$" },
        "nameZh": { "type": "string", "minLength": 1 },
        "nameEn": { "type": "string", "minLength": 1 }
      }
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "inventoryStatus": {
      "enum": ["verified-current-upload", "partial-current-upload", "unknown"]
    },
    "inventoryNote": { "type": "string" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceFiles", "publishedOriginals", "totalPages", "categoryCounts"],
      "properties": {
        "sourceFiles": { "type": "integer", "minimum": 0 },
        "publishedOriginals": { "type": "integer", "minimum": 0 },
        "totalPages": { "type": ["integer", "null"], "minimum": 0 },
        "categoryCounts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "materials": {
      "type": "array",
      "items": { "$ref": "#/$defs/material" }
    },
    "knownGaps": {
      "type": "array",
      "items": { "$ref": "#/$defs/gap" }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceAuditDate", "suggestedReviewDays", "updateTrigger"],
      "properties": {
        "sourceAuditDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "suggestedReviewDays": { "type": "integer", "minimum": 1 },
        "updateTrigger": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "originalFileName",
        "category",
        "format",
        "sequence",
        "pages",
        "bytes",
        "sha256",
        "sourceStatus",
        "originalUrl",
        "derivativeCount",
        "derivativeLabels",
        "note"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "originalFileName": { "type": "string", "minLength": 1 },
        "category": {
          "enum": [
            "lecture",
            "syllabus",
            "assignment",
            "solution",
            "exam",
            "reference",
            "dataset",
            "code",
            "notebook",
            "other"
          ]
        },
        "format": { "type": "string", "minLength": 1 },
        "sequence": { "type": ["string", "null"] },
        "pages": { "type": ["integer", "null"], "minimum": 0 },
        "bytes": { "type": ["integer", "null"], "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "sourceStatus": {
          "enum": ["published-original", "indexed-no-download"]
        },
        "originalUrl": { "type": ["string", "null"] },
        "derivativeCount": { "type": "integer", "minimum": 0 },
        "derivativeLabels": {
          "type": "array",
          "items": { "type": "string" }
        },
        "note": { "type": "string" }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "status", "note"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "status": {
          "enum": ["expected-missing", "not-received", "not-issued", "unknown"]
        },
        "note": { "type": "string" }
      }
    }
  }
}
