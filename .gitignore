# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem
~$*.pptx

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.dev.vars*
.npmrc
credentials.json
*.key
*.p12
*.pfx

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/outputs/
/work/
/tmp/
/.codex-build/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Internal source audits quote course-specific assessment evidence.
/analysis/

# Unused site-generator scaffolding retained only in the local workspace.
/.openai/
/build/
/db/
/drizzle/
/drizzle.config.ts
/examples/
/vite.config.ts
/worker/

# local launcher runtime
/logs/
/.phy301-site.pid

# GitHub Pages output is generated locally in docs/ and published from main.
# Course files under public/ are tracked deliberately.
